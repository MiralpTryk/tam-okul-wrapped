VUE_APP_API_URL=.tamokul.com/api # .tamokul.com/api or .tamokul.net/api
VUE_APP_TOKEN_KEY=userTokenStudent
VUE_APP_ENV=local # local or production
VUE_APP_URL=.tamokul.com # .tamokul.com or .tamokul.net
# yarn serve: /api isteklerinin yönlendirileceği backend (ör. https://tamokul.com veya http://localhost:8000)
API_PROXY_TARGET=https://tamokul.com
VUE_APP_SHOW_QUESTION_IMAGES=true
VUE_APP_IMAGE_BASE_URL=https://q.tamokul.com
